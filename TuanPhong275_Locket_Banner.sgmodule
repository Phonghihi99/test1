#!name=Locket Gold - TuanPhong275
#!desc=Locket-only module | TuanPhong275 | Based on duyvinh09
#!author=TuanPhong275 (based on duyvinh09)
#!moduleUrl=https://raw.githubusercontent.com/Phonghihi99/LocketGold/refs/heads/main/TuanPhong275_Locket_Banner.sgmodule
#!howtouse=Shadowrocket

# Locket only — adapted from duyvinh09/Module_IOS
# GitHub URL only becomes active after this file is uploaded there.

[Header Rewrite]
# Giữ lại hai quy tắc ETag từ module gốc
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del x-revenuecat-etag
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del X-RevenueCat-ETag

[Script]
# Locket / RevenueCat subscription response
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/duyvinh09/Module_IOS/refs/heads/main/js/Locket_DuyVinh09.js, requires-body=true, max-size=-1, timeout=60

# Locket / RevenueCat request header
# Original header script retained for compatibility.
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/duyvinh09/Module_IOS/refs/heads/main/js/deleteHeader.js, timeout=60

# Locket Firebase with TuanPhong275 banner - generated from working upstream
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/Phonghihi99/LocketGold/refs/heads/main/js/Locket_Unlocked.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com
